<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for entry in site.pages %}{% unless entry.noindex or entry.redirect_to or entry.url contains '.xml' or entry.url contains '.txt' %}{% if entry.url == '/' or entry.url contains '/projects/' or entry.url contains '/demos/' or entry.url == '/cv/' %}<url><loc>{{ entry.url | absolute_url | xml_escape }}</loc></url>{% endif %}{% endunless %}{% endfor %}
{% for project in site.projects %}<url><loc>{{ project.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
</urlset>
